JCA_JIRA_URL=https://your-company.atlassian.net
JCA_JIRA_EMAIL=you@example.com
JCA_JIRA_API_TOKEN=replace-me
JCA_JIRA_JQL=assignee = currentUser() AND statusCategory = 'To Do' ORDER BY priority DESC, created ASC

JCA_REPOSITORY=/absolute/path/to/your/repository
JCA_BASE_BRANCH=main
JCA_JIRA_POLL_SECONDS=600
JCA_QUOTA_REMAINING_THRESHOLD=30
JCA_QUOTA_WEEKLY_REMAINING_THRESHOLD=30
# JCA_CODEX_MODEL=
# JCA_CODEX_REASONING_EFFORT=high   # low | medium | high | xhigh | max | ultra (as supported by the model)
# JCA_CODEX_SERVICE_TIER=priority   # Fast mode; omit for standard speed
# JCA_DRY_RUN=true

# Unattended operation
# JCA_APPROVAL_TIMEOUT_SECONDS=900   # decline unanswered approvals; 0 waits forever
# JCA_MAX_TASK_ATTEMPTS=3            # failed/timed-out runs retry with back-off, then stay failed
# JCA_RETRY_BACKOFF_SECONDS=600      # multiplied by the attempt number
# JCA_HISTORY_RETENTION_DAYS=30      # logs of done/skipped tasks and archived queue rows expire
# JCA_MAX_EVENTS_PER_TASK=500
# JCA_PREVENT_SLEEP=true             # caffeinate while a task runs or a short quota wait is pending
# JCA_NOTIFICATIONS=true

# Optional Claude Code passes (read-only): plan before Codex codes, review after Codex reports COMPLETED
# JCA_CLAUDE_PLAN=true
# JCA_CLAUDE_REVIEW=true
# JCA_CLAUDE_FRONTEND=true             # Claude Code codes frontend issues (and the UI half of full-stack ones)
# JCA_CLAUDE_COMMAND=/opt/homebrew/bin/claude
# JCA_CLAUDE_MODEL=opus              # alias or full model id; omit for the CLI default
# JCA_CLAUDE_EFFORT=high             # low | medium | high | xhigh | max
# JCA_CLAUDE_REVIEW_ROUNDS=1         # Codex fix passes after Claude requests changes; 0 only reports
# JCA_CLAUDE_DECIDE=true             # Claude answers open product questions as PO; decisions are summarized for your review
# JCA_CLAUDE_DECIDE_ROUNDS=2         # Claude decision rounds after Codex asks; 0 only settles the plan's questions
# JCA_CLAUDE_DECIDE_PROMPT_BASE64=   # base64 of the product owner's instructions; empty uses default_decide_prompt.txt
# JCA_CLAUDE_TIMEOUT_SECONDS=1800
# JCA_CLAUDE_QUOTA_REMAINING_THRESHOLD=30         # skip Claude passes at <= 30% of the 5-hour limit left (/usage)
# JCA_CLAUDE_QUOTA_WEEKLY_REMAINING_THRESHOLD=30  # same for the weekly limit
# JCA_CLAUDE_MAX_TURNS=40                         # per pass; 0 = no limit

# Local checks run by the daemon after COMPLETED (base64 of one command per line), e.g.
# printf "pnpm install --frozen-lockfile\npnpm build\npnpm test\n" | base64
# JCA_VERIFY_COMMANDS_BASE64=
# JCA_VERIFY_FIX_ROUNDS=2
# JCA_VERIFY_TIMEOUT_SECONDS=1800
# JCA_BASELINE_CHECKS=true           # rerun a failing check on the base commit; same errors there are not blamed on the task
# JCA_BASELINE_SETUP_COMMAND=        # e.g. pnpm install --frozen-lockfile, run in the base worktree before its checks
# JCA_VERIFY_FLAKY_RETRIES=1         # rerun a check that failed with per-test timeouts before blaming the task
# JCA_CODEX_NETWORK_ACCESS=false     # sockets in Codex's sandbox; the daemon already runs Docker checks and UI captures
# JCA_UI_CAPTURE=true               # daemon renders the screens agents declare in ui_captures and checks their layout
# JCA_AUTO_APPROVE_COMMANDS_BASE64=  # base64 of command patterns approved without a human, one per line (./mvnw *)
