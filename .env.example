JCA_JIRA_URL=https://your-company.atlassian.net
JCA_JIRA_EMAIL=you@example.com
JCA_JIRA_API_TOKEN=replace-me
JCA_JIRA_JQL=assignee = currentUser() AND statusCategory = 'To Do' ORDER BY priority DESC, created ASC

JCA_REPOSITORY=/absolute/path/to/your/repository
JCA_BASE_BRANCH=main
JCA_JIRA_POLL_SECONDS=600
JCA_QUOTA_REMAINING_THRESHOLD=30
JCA_QUOTA_WEEKLY_REMAINING_THRESHOLD=30
# JCA_CODEX_MODEL=
# JCA_DRY_RUN=true

# Unattended operation
# JCA_APPROVAL_TIMEOUT_SECONDS=900   # decline unanswered approvals; 0 waits forever
# JCA_MAX_TASK_ATTEMPTS=3            # failed/timed-out runs retry with back-off, then stay failed
# JCA_RETRY_BACKOFF_SECONDS=600      # multiplied by the attempt number
# JCA_HISTORY_RETENTION_DAYS=30      # logs of done/skipped tasks and archived queue rows expire
# JCA_MAX_EVENTS_PER_TASK=500
# JCA_PREVENT_SLEEP=true             # caffeinate while a task runs or a short quota wait is pending
# JCA_NOTIFICATIONS=true
